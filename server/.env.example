# DearU v1 server 环境变量模板
# 复制为 .env 后填入真实值，.env 不进版本库（见 .gitignore）

# 微信小程序 AppID / AppSecret（微信公众平台 -> 开发 -> 开发设置）
# 本地开发若暂无真实小程序主体，可留空：/auth/wechat-login 会在缺失配置时返回明确的 501 占位错误，
# 不会用假值发出请求；devMode 登录（/auth/dev-login）不依赖这两个变量。
WX_APPID=
WX_SECRET=

# JWT 签名密钥，生产环境必须替换为随机强密钥，不可使用默认值
JWT_SECRET=dearu-dev-secret-change-in-production

# HTTP 服务监听端口
PORT=3000
