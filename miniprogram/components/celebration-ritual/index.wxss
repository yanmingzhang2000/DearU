.ritual-overlay {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 2000;
}

.ritual-scene {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.dark-gradient {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, #1a0f2e 0%, #2d1b4e 50%, #1a0f2e 100%);
}

.candle-canvas,
.confetti-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 10;
}

.lyrics-panel {
  position: absolute;
  left: 0;
  bottom: 15%;
  width: 100%;
  z-index: 20;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 60rpx;
}

.lyric-line {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-bottom: 16rpx;
  transition: all 0.3s ease;
  text-align: center;
}

.lyric-line.active {
  font-size: 40rpx;
  color: #ffd9ec;
  font-weight: 700;
  text-shadow: 0 0 20rpx rgba(255, 107, 157, 0.6);
}

.blow-hint {
  position: absolute;
  left: 0;
  bottom: 10%;
  width: 100%;
  z-index: 20;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 60rpx;
}

.blow-text {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 600;
  text-align: center;
}

.blow-fallback-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  text-align: center;
}

.wishing-panel {
  position: absolute;
  left: 0;
  top: 30%;
  width: 100%;
  z-index: 20;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.wish-title {
  font-size: 56rpx;
  color: #ffffff;
  font-weight: 700;
  text-shadow: 0 0 30rpx rgba(255, 107, 157, 0.8);
}

.wish-subtitle {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

.ritual-done-btn {
  position: absolute;
  left: 60rpx;
  right: 60rpx;
  bottom: 60rpx;
  z-index: 30;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #ff6b9d 0%, #c24d87 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}
