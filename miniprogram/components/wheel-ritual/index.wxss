.wheel-overlay {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 2000;
}

.wheel-scene {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.dark-gradient {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, #1a0f2e 0%, #2d1b4e 50%, #1a0f2e 100%);
}

.wheel-progress {
  position: absolute;
  top: 80rpx;
  left: 0;
  width: 100%;
  z-index: 20;
  display: flex;
  justify-content: center;
}

.progress-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin: 0 10rpx;
  background: rgba(255, 255, 255, 0.25);
  transition: background 0.3s ease;
}

.progress-dot.active {
  background: #ff6b9d;
}

.wheel-disc {
  position: relative;
  z-index: 10;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: conic-gradient(
    #ff6b9d 0deg 60deg,
    #ffd580 60deg 120deg,
    #a8d5a2 120deg 180deg,
    #8b5a3c 180deg 240deg,
    #ffb6c1 240deg 300deg,
    #c24d87 300deg 360deg
  );
  border: 6rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 0 40rpx rgba(255, 107, 157, 0.4);
}

.wheel-disc.spinning {
  animation: wheel-spin 2.2s cubic-bezier(0.2, 0.8, 0.3, 1) forwards;
}

@keyframes wheel-spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(1080deg); }
}

.wheel-text-panel {
  position: relative;
  z-index: 20;
  margin-top: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 60rpx;
}

.wheel-title {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 600;
}

.wheel-hint {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}

.wheel-result {
  margin-top: 20rpx;
  font-size: 40rpx;
  color: #ffd9ec;
  font-weight: 700;
  text-align: center;
  text-shadow: 0 0 20rpx rgba(255, 107, 157, 0.6);
}
