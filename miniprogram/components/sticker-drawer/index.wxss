.sticker-drawer {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 1000;
  display: none;
}

.sticker-drawer.visible {
  display: block;
}

.drawer-mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
}

.drawer-content {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  max-height: 60%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
}

.drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 20rpx;
  border-bottom: 2rpx solid #ffd9e6;
}

.drawer-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #5c3a40;
}

.close-btn {
  font-size: 48rpx;
  color: #9c8a86;
  line-height: 1;
}

.sticker-list {
  flex: 1;
  padding: 20rpx;
}

/* P1-5：分类分组 */
.sticker-group-label {
  font-size: 24rpx;
  color: #9c8a86;
  font-weight: 600;
  padding: 16rpx 8rpx 8rpx;
}

.sticker-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.sticker-item {
  width: calc(25% - 12rpx);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 8rpx;
  border-radius: 16rpx;
  background: #fffdf8;
}

.sticker-item:active {
  background: #ffeef3;
}

.sticker-preview {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 8rpx;
}

.sticker-name {
  font-size: 22rpx;
  color: #8a5a52;
}
