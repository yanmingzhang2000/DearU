<view class="sticker-drawer {{visible ? 'visible' : ''}}">
  <view class="drawer-mask" catchtap="onClose"></view>
  <view class="drawer-content">
    <view class="drawer-header">
      <text class="drawer-title">装饰贴纸</text>
      <text class="close-btn" catchtap="onClose">✕</text>
    </view>
    <scroll-view class="sticker-list" scroll-y>
      <block wx:for="{{groups}}" wx:key="key" wx:for-item="group">
        <view class="sticker-group-label">{{group.label}}</view>
        <view class="sticker-group">
          <view wx:for="{{group.items}}" wx:key="type"
                class="sticker-item"
                data-sticker="{{item.type}}"
                bindtap="onStickerTap">
            <image class="sticker-preview" src="/assets/stickers/{{item.type}}.png" mode="aspectFit"></image>
            <text class="sticker-name">{{item.label}}</text>
          </view>
        </view>
      </block>
    </scroll-view>
  </view>
</view>
