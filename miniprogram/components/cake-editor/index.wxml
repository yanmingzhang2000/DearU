<view class="cake-editor">
  <!-- 编辑区 -->
  <view class="editor-canvas-container">
    <!-- 底胚背景 -->
    <image class="cake-base" src="/assets/cakes/{{cakeState.style}}_{{cakeState.flavor}}.png" mode="aspectFit"></image>
    
    <!-- 贴纸层（P0-1：z-index 从 10 起，压过涂鸦 canvas，触摸才能落到贴纸上） -->
    <view wx:for="{{stickerLayers}}" wx:key="id" 
          class="sticker-layer {{selectedLayerId === item.id ? 'selected' : ''}}"
          style="transform: translate({{item.x}}rpx, {{item.y}}rpx) rotate({{item.rotate}}deg) scale({{item.scale}}); z-index: {{item.zIndex + 10}};"
          data-layer-id="{{item.id}}"
          catchtouchstart="onStickerTouchStart"
          catchtouchmove="onStickerTouchMove"
          catchtouchend="onStickerTouchEnd">
      <image wx:if="{{item.type === 'sticker'}}" class="sticker-img" src="/assets/stickers/{{item.stickerType}}.png" mode="widthFix"></image>
      <text wx:if="{{item.type === 'text'}}" class="text-content" style="color: {{item.color}};">{{item.text}}</text>
    </view>
    
    <!-- Canvas 涂鸦层 -->
    <canvas 
      type="2d" 
      id="stroke-canvas" 
      class="stroke-canvas"
      catchtouchstart="onCanvasTouchStart"
      catchtouchmove="onCanvasTouchMove"
      catchtouchend="onCanvasTouchEnd">
    </canvas>
  </view>

  <!-- P0-4：选中图层工具条（按钮化操作；选中贴纸/文字后出现，点空白处消失） -->
  <view wx:if="{{selectedLayerId && !readonly}}" class="layer-toolbar">
    <button class="layer-op danger" data-op="delete" bindtap="onDeleteLayer">删除</button>
    <button class="layer-op" data-op="shrink" bindtap="onLayerTransform">缩小</button>
    <button class="layer-op" data-op="grow" bindtap="onLayerTransform">放大</button>
    <button class="layer-op" data-op="rot-left" bindtap="onLayerTransform">左转</button>
    <button class="layer-op" data-op="rot-right" bindtap="onLayerTransform">右转</button>
  </view>

  <!-- 款式切换工具栏（v1.1：canEditBaseFlavor 为假时整体禁用态样式，见规格第 4.1 节） -->
  <view class="base-selector {{!canEditBaseFlavor ? 'base-selector-locked' : ''}}">
    <text class="toolbar-label">蛋糕底胚{{lockBaseFlavor ? '（已锁定）' : (!canEditBaseFlavor ? '（寿星决定）' : '')}}</text>
    <scroll-view class="base-options" scroll-x>
      <view wx:for="{{styles}}" wx:key="value"
            class="base-option {{cakeState.style === item.value ? 'active' : ''}} {{!canEditBaseFlavor ? 'disabled' : ''}}"
            data-style="{{item.value}}"
            bindtap="onStyleChange">
        <image class="base-thumb" src="/assets/cakes/{{item.value}}_{{flavorLocked ? 'original' : cakeState.flavor}}_thumb.png" mode="aspectFit"></image>
        <text class="base-label">{{item.label}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 口味切换工具栏 -->
  <view class="base-selector {{!canEditBaseFlavor ? 'base-selector-locked' : ''}}">
    <text class="toolbar-label">口味{{lockBaseFlavor ? '（已锁定）' : (!canEditBaseFlavor ? '（寿星决定）' : (flavorLocked ? '（巴斯克仅原味）' : ''))}}</text>
    <scroll-view class="base-options" scroll-x>
      <view wx:for="{{flavors}}" wx:key="value"
            class="base-option {{(flavorLocked ? 'original' : cakeState.flavor) === item.value ? 'active' : ''}} {{(flavorLocked || !canEditBaseFlavor) ? 'disabled' : ''}}"
            data-flavor="{{item.value}}"
            bindtap="onFlavorChange">
        <view class="flavor-dot" style="background: {{item.value === 'vanilla' ? '#FFF8E7' : item.value === 'strawberry' ? '#FFB6C1' : item.value === 'matcha' ? '#A8D5A2' : item.value === 'chocolate' ? '#8B5A3C' : '#FFD580'}};"></view>
        <text class="base-label">{{item.label}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 笔刷工具栏 -->
  <view class="brush-selector">
    <text class="toolbar-label">奶油笔刷</text>
    <view class="brush-options">
      <view wx:for="{{brushTypes}}" wx:key="value"
            class="brush-option {{currentBrush === item.value ? 'active' : ''}}"
            data-brush="{{item.value}}"
            bindtap="onBrushChange">
        <text class="brush-icon">{{item.icon}}</text>
        <text class="brush-label">{{item.label}}</text>
      </view>
    </view>

    <!-- P1-3：颜色调色板（涂鸦与文字祝福共用） -->
    <view class="stroke-color-row">
      <view wx:for="{{strokePalette}}" wx:key="value"
            class="color-dot {{currentStrokeColor === item.value ? 'active' : ''}}"
            style="background: {{item.value}};"
            data-color="{{item.value}}"
            bindtap="onColorChange">
        <text wx:if="{{currentStrokeColor === item.value}}" class="color-check">✓</text>
      </view>
    </view>

    <!-- P1-4：粗细两档 -->
    <view class="stroke-width-row">
      <text class="width-label">粗细</text>
      <view wx:for="{{strokeWidths}}" wx:key="value"
            class="width-option {{currentStrokeWidth === item.value ? 'active' : ''}}"
            data-width="{{item.value}}"
            bindtap="onWidthChange">
        <view class="width-preview" style="height: {{item.value / 2}}rpx;"></view>
        <text>{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 操作按钮栏 -->
  <view class="action-bar">
    <button class="action-btn" disabled="{{!canUndo}}" bindtap="onUndo">撤销</button>
    <button class="action-btn" disabled="{{!canRedo}}" bindtap="onRedo">重做</button>
    <button class="action-btn" disabled="{{!selectedLayerId}}" bindtap="onDeleteLayer">删除</button>
    <button class="action-btn danger" bindtap="onClear">清空</button>
  </view>
</view>
