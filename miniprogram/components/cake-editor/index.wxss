.cake-editor {
  display: flex;
  flex-direction: column;
  width: 100%;
}

/* 编辑区容器 */
.editor-canvas-container {
  position: relative;
  width: 100%;
  height: 600rpx;
  background: #fffdf8;
  border-radius: 24rpx;
  overflow: hidden;
  border: 2rpx solid #ffd9e6;
}

.cake-base {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* 贴纸层 */
.sticker-layer {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 120rpx;
  height: 120rpx;
  margin-left: -60rpx;
  margin-top: -60rpx;
  transform-origin: center center;
  touch-action: none;
}

.sticker-layer.selected {
  outline: 4rpx dashed #e8768f;
  border-radius: 8rpx;
}

.sticker-img {
  width: 100%;
  height: 100%;
}

.text-content {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  font-size: 28rpx;
  font-weight: 600;
  white-space: nowrap;
}

/* Canvas 涂鸦层（P0-1：垫在贴纸层下面，贴纸才能收到触摸） */
.stroke-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

/* P2-2：拖拽吸附提示点——命中建议落点时淡淡发光，纯视觉辅助，不参与触摸事件 */
.snap-hint {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 24rpx;
  height: 24rpx;
  margin-left: -12rpx;
  margin-top: -12rpx;
  border-radius: 50%;
  background: rgba(232, 118, 143, 0.35);
  box-shadow: 0 0 16rpx rgba(232, 118, 143, 0.5);
  pointer-events: none;
  z-index: 5;
}

/* P0-4：选中图层工具条 */
.layer-toolbar {
  display: flex;
  margin-top: 16rpx;
  gap: 12rpx;
}

.layer-op {
  flex: 1;
  font-size: 24rpx;
  padding: 0;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  background: #ffeef3;
  color: #e8768f;
  border: none;
}

.layer-op::after {
  border: none;
}

.layer-op.danger {
  background: #ffe3df;
  color: #d9534f;
}

/* 底胚选择器 */
.base-selector {
  margin-top: 20rpx;
}

.toolbar-label {
  display: block;
  color: #9c8a86;
  font-size: 24rpx;
  margin-bottom: 12rpx;
}

.base-options {
  display: flex;
  white-space: nowrap;
}

.base-option {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 20rpx;
  padding: 12rpx;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
}

.base-option.active {
  border-color: #ffc233;
  background: #fff3c4;
}

.base-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
}

.base-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a5a52;
}

/* 口味色块 */
.flavor-dot {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 2rpx solid #ffd9e6;
}

.base-option.disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* v1.1：底胚/口味区整体锁定态样式（decorating 阶段起，见规格第 4.1 节） */
.base-selector-locked .toolbar-label {
  color: #c9b8ae;
}

/* 笔刷选择器 */
.brush-selector {
  margin-top: 24rpx;
}

.brush-options {
  display: flex;
}

.brush-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  padding: 16rpx;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
}

.brush-option.active {
  border-color: #ffc233;
  background: #fff3c4;
}

.brush-icon {
  font-size: 32rpx;
}

.brush-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a5a52;
}

/* P1-3：颜色调色板 */
.stroke-color-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 0 8rpx;
}

.color-dot {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 4rpx solid transparent;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.12);
}

.color-dot.active {
  border-color: #fff;
  outline: 4rpx solid #e8768f;
}

.color-check {
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
  text-shadow: 0 0 4rpx rgba(0, 0, 0, 0.45);
}

/* P1-4：粗细两档 */
.stroke-width-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  gap: 16rpx;
}

.width-label {
  font-size: 24rpx;
  color: #8a5a52;
}

.width-option {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 24rpx;
  border-radius: 28rpx;
  border: 2rpx solid #ffd9e6;
  background: #fff;
  font-size: 24rpx;
  color: #8a5a52;
}

.width-option.active {
  border-color: #ffc233;
  background: #fff3c4;
  color: #5c3a40;
  font-weight: bold;
}

.width-preview {
  width: 40rpx;
  border-radius: 8rpx;
  background: currentColor;
}

/* 操作按钮栏 */
.action-bar {
  display: flex;
  margin-top: 24rpx;
  gap: 12rpx;
}

.action-btn {
  flex: 1;
  font-size: 24rpx;
  padding: 0;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  background: #ffeef3;
  color: #e8768f;
  border: none;
}

.action-btn[disabled] {
  opacity: 0.4;
}

.action-btn.danger {
  background: #ffe3df;
  color: #d9534f;
}
