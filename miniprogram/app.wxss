page {
  background: #fffdf8;
  color: #4a3428;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
}

button {
  border-radius: 24rpx;
  font-size: 28rpx;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 48rpx 32rpx 80rpx;
}

.card {
  margin-top: 24rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 36rpx rgba(232, 118, 143, 0.1);
}

.primary-button {
  color: #ffffff;
  background: #e8768f;
}

.secondary-button {
  color: #e8768f;
  background: #ffeef3;
}

.muted {
  color: #9c8a86;
}

.error-text {
  color: #d9534f;
}
