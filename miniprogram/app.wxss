page {
  background: #fff8fb;
  color: #3f2635;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
}

button {
  border-radius: 24rpx;
  font-size: 28rpx;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 48rpx 32rpx 80rpx;
}

.card {
  margin-top: 24rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 36rpx rgba(171, 73, 117, 0.08);
}

.primary-button {
  color: #ffffff;
  background: #e95d9b;
}

.secondary-button {
  color: #a43d70;
  background: #fff0f6;
}

.muted {
  color: #9c7d8c;
}

.error-text {
  color: #c14468;
}
