<view class="page">
  <view wx:if="{{loading}}" class="loading-state">正在读取房间…</view>

  <view wx:elif="{{error}}" class="card error-card">
    <text class="error-title">链接无效或无权访问</text>
    <text class="error-detail">{{error}}</text>
    <text class="muted">为了保护你们的私密内容，不是你们两个人打开的链接，不会显示任何房间信息。</text>
    <button class="secondary-button" bindtap="loadRoom">重新尝试</button>
  </view>

  <block wx:else>
    <view class="room-header">
      <text class="eyebrow">亲爱的你 · 生日房间</text>
      <view class="room-title-row">
        <text class="room-title">你们的蛋糕</text>
        <text class="status-pill">{{situationLabel}}</text>
      </view>
    </view>

    <view class="card privacy-card">
      <text class="card-title">这是你们两个人的房间</text>
      <text class="muted">这个房间只属于你们两个人。链接只是进门的那把钥匙，内容只保存在你们之间。</text>
    </view>

    <!-- v1.1：collaborating 阶段内，making_phase 决定展示哪个子阶段的交互（规格第 1 节五态分支） -->
    <view wx:if="{{room.status === 'collaborating'}}" class="card making-phase-card">
      <text class="card-title">{{makingPhaseLabel}}</text>

      <block wx:if="{{room.makingPhase === 'awaiting_both'}}">
        <text class="body-text">等 TA 进房后才能开启转盘。</text>
      </block>

      <block wx:elif="{{room.makingPhase === 'wheel_ready'}}">
        <text class="body-text">{{role === 'creator' ? 'TA 已经进房啦，点击开启转盘。' : '等待房主开启转盘。'}}</text>
        <button wx:if="{{canOpenWheel}}" class="primary-button main-button" bindtap="onWheelOpen">开启转盘</button>
      </block>

      <block wx:elif="{{room.makingPhase === 'wheel_playing'}}">
        <text class="body-text">转盘正在播放，请留意屏幕动画。</text>
      </block>
    </view>

    <view wx:if="{{room.status === 'draft' || (room.status === 'collaborating' && (room.makingPhase === 'cake_editing' || room.makingPhase === 'decorating'))}}" class="card">
      <text class="card-title">一起做这块蛋糕</text>
      <text class="body-text">{{role === 'creator' ? '把邀请发给 TA，让 TA 来定今天的蛋糕；之后你们一起画。' : '今天你说了算——挑个喜欢的底胚和口味，再一起画点什么。'}}</text>

      <view wx:if="{{role === 'creator'}}" class="nickname-row">
        <text class="nickname-label">TA 的昵称</text>
        <input class="nickname-input" value="{{inviteeNickname}}" placeholder="写进歌里的称呼，比如小笨蛋" maxlength="12" bindblur="onNicknameBlur" />
      </view>

      <cake-editor
        id="cakeEditor"
        initial-state="{{room.cakeState}}"
        readonly="{{!canEditCake}}"
        can-edit-base-flavor="{{canEditBaseFlavor}}"
        lock-base-flavor="{{lockBaseFlavor}}"
        bind:change="onCakeChange"
        bind:draggingLayerChange="onCakeDraggingLayerChange"
        bind:deleteLayer="onDeleteLayer">
      </cake-editor>

      <button wx:if="{{canEditCake}}" class="secondary-button main-button" bindtap="openStickerDrawer">添加装饰</button>
      <button wx:if="{{canEditCake}}" class="secondary-button main-button" bindtap="writeBlessing">写句祝福</button>
      <button wx:if="{{role === 'invitee' && room.makingPhase === 'cake_editing'}}" class="primary-button main-button" bindtap="onCakeLock">锁定底胚和口味</button>

      <button wx:if="{{canReady}}" class="primary-button main-button" bindtap="markReady">我选好了</button>
      <button wx:if="{{canSeal}}" class="primary-button main-button" bindtap="sealRoom">封装礼盒</button>
    </view>

    <wheel-ritual
      visible="{{wheelRitualVisible}}"
      bind:complete="onWheelRitualComplete">
    </wheel-ritual>

    <sticker-drawer
      visible="{{stickerDrawerVisible}}"
      bind:select="onStickerSelect"
      bind:close="onStickerDrawerClose">
    </sticker-drawer>

    <view wx:if="{{room.status === 'sealed' || room.status === 'awaiting'}}" class="card celebration-card">
      <text class="card-title">就差一起庆祝了</text>
      <text class="body-text">打开和 TA 的微信通话，两个人各自点「开始庆祝」。这会儿不要求同屏，也不用等对方先点。</text>
      <button wx:if="{{canCelebrate}}" class="primary-button main-button" bindtap="startCelebration">开始庆祝</button>
    </view>

    <celebration-ritual
      visible="{{ritualVisible}}"
      nickname="{{inviteeNickname}}"
      bind:complete="onRitualComplete">
    </celebration-ritual>

    <view wx:if="{{room.status === 'completed'}}" class="card celebration-card">
      <text class="card-title">庆祝完成</text>
      <text class="body-text">这场仪式会在保留期内随时可回看。要不要给 TA 留句“好甜”？</text>
      <button class="secondary-button main-button" bindtap="reportExpression">好甜，留下反馈</button>
    </view>

    <view wx:if="{{canSendInvite}}" class="card invite-card">
      <text class="card-title">邀请 TA 来一起做</text>
      <text class="muted">建房即生成，封装后不再生成第二个。</text>
      <text class="invite-path">{{invitePath}}</text>

      <view class="share-title-preview" bindtap="openShareTitleEditor">
        <text class="share-title-label">分享文案</text>
        <text class="share-title-text">{{shareTitle}}</text>
        <text class="share-title-edit-hint">点击更换</text>
      </view>

      <button class="secondary-button main-button" bindtap="sendInvite">复制邀请链接</button>
      <button class="secondary-button main-button" open-type="share">发给 TA</button>
    </view>
  </block>

  <!-- 分享文案选择弹层：预设 3 条 + 自定义输入（规格 §3.5/§3.6，仅房主可打开） -->
  <view wx:if="{{shareTitleEditorVisible}}" class="share-title-mask" bindtap="closeShareTitleEditor">
    <view class="share-title-sheet" catchtap="noop">
      <text class="card-title">选一句发给 TA 的文案</text>
      <text class="muted">这是分享卡片上唯一会显示的文字，没有 emoji 更像真心话。</text>

      <view
        wx:for="{{sharePresets}}"
        wx:key="*this"
        class="share-title-option {{shareTitle === item ? 'share-title-option-active' : ''}}"
        data-title="{{item}}"
        bindtap="selectShareTitlePreset">
        <text>{{item}}</text>
      </view>

      <view class="share-title-custom">
        <text class="share-title-label">或自己写一句</text>
        <textarea
          class="share-title-textarea"
          value="{{shareTitleDraft}}"
          placeholder="懒得写也没关系，用上面的预设就很好"
          maxlength="50"
          bindinput="onShareTitleDraftInput">
        </textarea>
        <button class="primary-button main-button" bindtap="confirmShareTitleDraft">用这句</button>
      </view>

      <button class="secondary-button main-button" bindtap="closeShareTitleEditor">取消</button>
    </view>
  </view>
</view>
