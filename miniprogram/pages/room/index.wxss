.loading-state {
  padding-top: 180rpx;
  color: #9c7d8c;
  text-align: center;
  font-size: 28rpx;
}

.room-header {
  padding: 24rpx 8rpx 8rpx;
}

.eyebrow {
  display: block;
  color: #c24d87;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.room-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.room-title {
  color: #572b46;
  font-size: 52rpx;
  font-weight: 700;
}

.status-pill {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  color: #a43d70;
  background: #ffe8f2;
  font-size: 24rpx;
}

.nickname-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-bottom: 18rpx;
  border-bottom: 2rpx solid #fff0f6;
}

.nickname-label {
  color: #73445c;
  font-size: 26rpx;
}

.nickname-input {
  flex: 1;
  margin-left: 20rpx;
  text-align: right;
  color: #572b46;
  font-size: 26rpx;
}

.card-title {
  display: block;
  color: #572b46;
  font-size: 32rpx;
  font-weight: 700;
}

.body-text,
.muted {
  display: block;
  margin-top: 14rpx;
  color: #9c7d8c;
  font-size: 26rpx;
  line-height: 1.7;
}

.state-line {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-bottom: 18rpx;
  border-bottom: 2rpx solid #fff0f6;
  color: #73445c;
  font-size: 26rpx;
}

.main-button {
  margin-top: 22rpx;
}

.invite-path {
  display: block;
  box-sizing: border-box;
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  color: #a43d70;
  background: #fff4f8;
  font-size: 22rpx;
  word-break: break-all;
}

.error-card {
  margin-top: 160rpx;
  text-align: center;
}

.error-title {
  display: block;
  color: #c14468;
  font-size: 34rpx;
  font-weight: 700;
}

.error-detail {
  display: block;
  margin-top: 20rpx;
  color: #c14468;
  font-size: 26rpx;
}

.error-card button {
  margin-top: 28rpx;
}

.privacy-card {
  border: 2rpx solid #f7d3e2;
  background: #fffdfd;
}

.share-title-preview {
  box-sizing: border-box;
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #fff4f8;
}

.share-title-label {
  display: block;
  color: #c24d87;
  font-size: 22rpx;
}

.share-title-text {
  display: block;
  margin-top: 8rpx;
  color: #572b46;
  font-size: 26rpx;
  line-height: 1.6;
}

.share-title-edit-hint {
  display: block;
  margin-top: 8rpx;
  color: #a43d70;
  font-size: 22rpx;
}

.share-title-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(63, 38, 53, 0.4);
}

.share-title-sheet {
  box-sizing: border-box;
  width: 100%;
  max-height: 80vh;
  padding: 32rpx 32rpx 48rpx;
  border-radius: 32rpx 32rpx 0 0;
  background: #ffffff;
  overflow-y: auto;
}

.share-title-option {
  box-sizing: border-box;
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 14rpx;
  border: 2rpx solid #fff0f6;
  background: #fff8fb;
  color: #572b46;
  font-size: 26rpx;
  line-height: 1.6;
}

.share-title-option-active {
  border-color: #e95d9b;
  background: #ffe8f2;
}

.share-title-custom {
  margin-top: 28rpx;
}

.share-title-textarea {
  box-sizing: border-box;
  width: 100%;
  margin-top: 12rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #fff8fb;
  color: #3f2635;
  font-size: 26rpx;
  min-height: 100rpx;
}
